@font-face {
    font-family: 'jetbrains mono';
    font-style: normal;
    font-weight: 400;
    src: local("Open Sans"),
    url("../fonts/JetBrainsMonoNL-Medium.ttf") format("truetype");
}


/* header */
body {
    margin: 0;
    background-color: #020610;
}

header {
    padding: 1%;

}

h1 {
    text-align: center;
    color: #e4eafc;
    padding-top: 1%;
    font-family: "jetbrains mono", sans-serif
}

ul li {
    display: inline-block;
    padding: 1%;
    position: relative;
    left: 10%;
    width: 10vw;
}

nav li a {
    display: inline-block;
    width: 10vw;
    height: 3vh;
    text-align: center;
    color: #799cef;
    text-decoration: none;
    border-radius: 40px;
    padding-top: 5%;
    font-family: "jetbrains mono", sans-serif
}

a {
    font-family: "jetbrains mono", sans-serif
}

nav li a:hover {
    color: #ae24e5;

}

/* fin de header */


/* logo */

#logo {
    position: absolute;
    top: 4%;
    left: 2%;
    width: 7vw;
    height: 10vh;
    object-fit: contain;
}

/* fin logo */

/* botones*/
button {
    background-color: #0c8fd5;
    color: white;
    border-radius: 30px;
    text-decoration: none;
    font-size: 20px;
    margin: 10px;
    border-style: solid;
}

/* fin botones*/

/* encabezados */

h2 {
    color: #e4eafc;
}

/* fin encabezados */


