.formularios_cajas {
    display: flex; /* Use flexbox for layout */
    justify-content: space-between; /* Space between articles */
    gap: 20%
}

.formularios_cajas article {
    margin-right: 20px; /* Space between articles */
    flex: 1; /* Allow articles to grow equally */
    min-width: 300px; /* Optional: Set a minimum width for articles */
}

form {
    color: #e4eafc;
    line-height: 200%;
    font-family: "jetbrains mono", sans-serif;
    margin:15%;

}

/* fin formularios */

/* footer */
footer {
    text-align: left;
    padding: 3%;
    color: #e4eafc;
    font-family: "jetbrains mono", sans-serif
}

footer a:visited {
    color: #799cef;
}

/* fin de footer */