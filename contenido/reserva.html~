  const boton1 = document.getElementById("boton_add");
  const boton_borrar2 = document.getElementById("boton_borrar");
  const precio_menu = 25;
  let clicks = 0;

  // Un array para almacenar los menús seleccionados
  let menus = [];

  //Crear eventos y cadenas
  boton1.addEventListener("click", function () {
      const resultado = document.getElementById("selector").value;
      menus.push("Menú de: " + resultado); // Añadir el menú al array
      document.getElementById("menu_seleccionado").innerHTML = menus.join("<br>"); // Mostrar todos los menús
      clicks++; // Incrementar el contador de clics
      const total = clicks * precio_menu; // Calcular el total
      document.getElementById("total_pagar").innerHTML = "Total a pagar: " + total + " Euros"; // Actualizar el total
  });

  //borar ultima linea

  boton_borrar2.addEventListener("click", function () {
      menus.pop(); // Eliminar el último menú del array
      clicks--; // Decrementar el contador de clics
      const total = clicks * precio_menu; // Calcular el nuevo total
      document.getElementById("menu_seleccionado").innerHTML = menus.join("<br>"); // Actualizar la visualización
      document.getElementById("total_pagar").innerHTML = "Total a pagar: " + total + " Euros"; // Actualizar el total
  });

</script>

