<!--reserva-->

<div class="formularios_cajas">
    <article id="info_personal">

        <form>
            <fieldset>
                <h2> Reservas </h2>
                <label id="l1" for="id_nombre">Escriba su nombre:</label>
                <input type="text"
                       id="id_nombre"
                       name="nombre"
                       placeholder="Escribe tu nombre aqui"/> <br>


                <label for="id_email"><strong>Escriba su email</strong></label>
                <input type="email" id="id_email" name="email" placeholder="Escribe tu email">
                <br>

                <label for="id_telefono">Escriba su telefono</label>
                <input type="tel" id="id_telefono" name="telefono" placeholder="Escribe tu telefono">
                <br>

                <label for="id_fecha"><strong>Seleccione fecha</strong></label>
                <input type="date" id="id_fecha" name="fecha">
                <br>

                <label for="id_hora">Seleccione hora</label>
                <input type="time" id="id_hora" name="hora">
                <br>
                <label for="id_personas"> Seleccione cantidad de personas </label>
                <input type="number" id="id_personas" name="personas" min="1" max="30"> <br>
                <label for="terraza_exteriror"> Seleccione terraza </label> <br>
                <input type="radio" id="terraza_exteriror" name="Exterior" value="exterior">
                <label for="terraza_exteriror"> Exterior</label>
                <input type="radio" id="terraza_interior" name="interior" value="interior">
                <label for="terraza_interior"> Interior</label>
                <br>
                <label for="alergia"> ¿Tienes alguna alergia ?</label> <br>
                <input type="radio" id="si_alergia" name="Si" value="si">
                <label for="si_alergia">Si</label>
                <input type="radio" id="no_alergia" name="No" value="no">
                <label for="no_alergia">No</label> <br>
                <label for="alergia"> Escriba su alergia</label> <br>
                <textarea id="alergia" rows="4" cols="50" placeholder="Escribe su alergia aqui"></textarea> <br>
                <input type="button" value="Enviar">
                <br>
            </fieldset>
        </form>
    </article>

    <!--pago-->

    <article id="info_pago">
        <form>
            <label> Selecione Menú Degustación
                <select>
                    <option value=" Menú Puerto Rico "> Menú Puerto Rico </option>
                    <option value=" Menú Colombia "> Menú Colombia </option>
                    <option value="Menú Argelian "> Menú Argelia </option>
                    <option value="Menú España "> Menú España </option>

                </select>
            </label>

            <fieldset>
                <h2>Métodos de pago</h2>
                <label for="id_tarjeta"> Escriba número de tarjeta <small>(Campo obligatorio para realizar la
                    transacción)</small></label>
                <br>
                <input type="tel" id="id_tarjeta" name="TJ" placeholder="XXXX-XXXX-XXXX-XXXX" required>
                <br>
                <label for="id_CD">Caducidad final <small>(Campo obligatorio para realizar la
                    transacción)</small></label>
                <br>
                <input type="tel" id="id_CD" name="CD" placeholder="XX/XX" required>
                <br>
                <label for="id_CVV">Escriba CVV <small>(Campo obligatorio para realizar la
                    transacción)</small></label>
                <br>
                <input type="tel" id="id_CVV" name="CVV" placeholder="XXX" required> <br>
                <input type="button" value="Pagar">
            </fieldset>
        </form>
    </article>
